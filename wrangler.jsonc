// Vercel's production output (cloudflare/dist/, see cloudflare/README.md) on
// Workers static assets. Nothing is built: `wrangler deploy` uploads the
// committed files. worker.ts runs first to keep Vercel's redirects (http ->
// https, apex -> www), HSTS and to add the Web Analytics beacon.
{
  "name": "ezeikel-pemberton-photography-web",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "vars": {
    // Public token of the zone-level Web Analytics site of ezeikelpemberton.photography (created
    // March 2026, so it needs no new site slot); it ends up in every page, so it is not a secret.
    // The Worker adds send.to "/cdn-cgi/rum" because this is a zone token (see cloudflare/worker.ts).
    "CF_WEB_ANALYTICS_TOKEN": "c114af4c9c41414589aeb8def6105584"
  },
  "assets": {
    "directory": "cloudflare/dist",
    "binding": "ASSETS",
    // Files are served exactly at their own path (/index.html stays 200, as on
    // Vercel); everything else falls back to index.html with 200.
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
